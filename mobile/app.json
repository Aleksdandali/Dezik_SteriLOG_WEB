{
  "expo": {
    "name": "Dezik Staff",
    "slug": "dezik-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dezikstaff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ua.dezik.staff",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ua.dezik.staff",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6c5c8222-035a-499d-8bb7-b56f4a4cf1d8"
      }
    },
    "owner": "shineshopb2b"
  }
}
