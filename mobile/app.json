{
  "expo": {
    "name": "Dezik Staff",
    "slug": "dezik-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dezikstaff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ua.dezik.staff"
    },
    "android": {
      "package": "ua.dezik.staff",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
